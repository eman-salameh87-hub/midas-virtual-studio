# Copy this file to `.env` in the repo root. Do not commit `.env`.
# python-dotenv loads `.env` automatically for local persist (and OpenRouter).
# It does not override variables already set in the process.
# `.env.example` is never loaded by the backend.

# Operator-provided local persist labels for UIMidas Manual briefs.
# Not production identity and not Architecture A canonical values.
# Required for POST /api/v1/client-briefs when the body omits
# owner_id / contract_id / revision. Replace these with your local labels.
MIDAS_DEV_OWNER_ID=dev-owner
MIDAS_DEV_CONTRACT_ID=dev-contract
# MIDAS_DEV_CONTRACT_REVISION=1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=60

# Backend-owned stage models. The public API does not accept model_id.
# Leave unset to use the proven defaults.
# MIDAS_EYE_MODEL=openai/gpt-4.1
# MIDAS_BRAIN_MODEL=openai/gpt-4.1
# MIDAS_STYLIST_MODEL=openai/gpt-4.1
# MIDAS_CRITIQUE_MODEL=openai/gpt-4.1
# MIDAS_IMAGE_MODEL=google/gemini-3.1-flash-image
